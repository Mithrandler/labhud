# --- Your own JSON endpoints ---------------------------------------------------------------
# Any service that answers GET with a JSON object becomes source "<name>" (lowercase).
# Several URLs as "label=url,label=url" give "<name>.<label>.<key>" paths.
#LABHUD_JSON_TEMP_URL=node1=http://192.0.2.11:9189/,node2=http://192.0.2.12:9189/
#LABHUD_JSON_TEMP_EVERY=10
#LABHUD_JSON_TEMP_TIMEOUT=8

# --- kept across restarts ---------------------------------------------------------------------
# A writable folder (a volume, owned by uid 10001): the history, the sparklines and maintenance
# set from the display survive a restart, in labhud.db (SQLite). Unset: kept in memory only.
#LABHUD_DATA=/data

# --- pushed sources (docs/live-agent.md) ----------------------------------------------------
# An agent POSTs its JSON to /api/push/<name>, signed with this key; one key per agent.
#LABHUD_PUSH_PVE_KEY=
#LABHUD_PUSH_PVE_STALE=60
# A polled JSON endpoint that wants a key:
#LABHUD_JSON_LIVE_AUTH=Bearer <key>

# --- integrations (docs/integrations.md) ------------------------------------------------------
#LABHUD_HEALTHCHECKS_URL=https://healthchecks.io
#LABHUD_HEALTHCHECKS_KEY=

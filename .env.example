# --- Your own JSON endpoints ---------------------------------------------------------------
# Any service that answers GET with a JSON object becomes source "<name>" (lowercase).
# Several URLs as "label=url,label=url" give "<name>.<label>.<key>" paths.
#LABHUD_JSON_TEMP_URL=node1=http://192.0.2.11:9189/,node2=http://192.0.2.12:9189/
#LABHUD_JSON_TEMP_EVERY=10
#LABHUD_JSON_TEMP_TIMEOUT=8

# labhud settings. Copy to .env and fill in only what you have: every source is optional.
# A source with no URL or no key is shown as "not configured", never as an error.
# Keys stay on the server; the browser only ever sees the results.

# --- the server ---------------------------------------------------------------------------
# Names the display may be requested under ("host:port", as the browser sends them).
# Anything else gets 421 — this stops DNS rebinding from reading your snapshot.
LABHUD_HOSTS=localhost:8095,127.0.0.1:8095
#LABHUD_PORT=8095
#LABHUD_CONFIG=/app/config.toml
# Where the browser sends actions (POST <url><action>). Empty: no action buttons.
# labhud never runs actions itself; an agent you control does (docs/actions.md).
#LABHUD_ACTION_URL=http://192.0.2.10:9189/action/

# --- Proxmox VE (one block per node; standalone nodes and clusters both work) ---------------
# Put the node that is always on first: it carries the combined storage list.
#LABHUD_PROXMOX_NODES=pve,node2
#LABHUD_PROXMOX_PVE_URL=https://192.0.2.11:8006
#LABHUD_PROXMOX_PVE_TOKEN_ID=labhud@pve!labhud
#LABHUD_PROXMOX_PVE_TOKEN_SECRET=

# --- Proxmox Backup Server -----------------------------------------------------------------
#LABHUD_PBS_URL=https://192.0.2.12:8007
#LABHUD_PBS_TOKEN_ID=labhud@pbs!labhud
#LABHUD_PBS_TOKEN_SECRET=

# --- OPNsense (a user with page-diagnostics-system-activity + page-status-trafficgraph) -----
#LABHUD_OPNSENSE_URL=https://192.0.2.1
#LABHUD_OPNSENSE_KEY=
#LABHUD_OPNSENSE_SECRET=

# --- Synology DSM --------------------------------------------------------------------------
#LABHUD_SYNOLOGY_URL=http://192.0.2.20:5000
#LABHUD_SYNOLOGY_USER=
#LABHUD_SYNOLOGY_PASS=

# --- OpenMediaVault disk agent (JSON, no auth) ---------------------------------------------
#LABHUD_OMV_URL=http://192.0.2.21:9190/


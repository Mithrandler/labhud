# labhud settings. Copy to .env and fill in only what you have: every source is optional.
# A source with no URL or no key is shown as "not configured", never as an error.
# Keys stay on the server; the browser only ever sees the results.

# --- the server ---------------------------------------------------------------------------
# Names the display may be requested under ("host:port", as the browser sends them).
# Anything else gets 421 — this stops DNS rebinding from reading your snapshot.
LABHUD_HOSTS=localhost:8095,127.0.0.1:8095
#LABHUD_PORT=8095
#LABHUD_CONFIG=/app/config.toml
# A .env labhud reads itself (the setup page writes one next to config.toml). Its lines only fill
# variables the environment does not set. Default: .env in the config file's folder, if there is one.
#LABHUD_ENV_FILE=/config/.env
# With no config.toml, labhud serves the setup page (code in the log). off: stop with an error instead.
#LABHUD_SETUP=on
# Where the browser sends actions (POST <url><action>). Empty: no action buttons.
# labhud never runs actions itself; an agent you control does (docs/actions.md).
#LABHUD_ACTION_URL=http://192.0.2.10:9189/action/
# Signed actions (recommended): the display posts to labhud, which forwards each action to the
# agent with an HMAC made with this secret (the agent's LABHUD_AGENT_SECRET). Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#LABHUD_ACTION_SECRET=
# Seconds a configured source may keep failing before the top bar shows a mark (see /status).
#LABHUD_SOURCE_GRACE=300
# Seconds a failing source keeps showing its last good answer before its cards show the error,
# so one missed poll changes nothing on screen. 0: show every failure at once.
#LABHUD_SOURCE_STALE=60
# Seconds a number must stay past its critical mark (92% CPU/RAM/disk, 85 °C) before it becomes
# an event and a notification; it clears 5 points (3 °C) under the mark.
#LABHUD_ALERT_HOLD=300
# Any source's poll interval, in seconds (minimum 2): LABHUD_<SOURCE>_EVERY, e.g.
#LABHUD_PROXMOX_EVERY=10
#LABHUD_WEATHER_EVERY=900

# --- certificates and secrets ---------------------------------------------------------------
# HTTPS certificates of your services. Without a setting they are NOT checked (most homelab
# certificates are self-signed), and anyone who can get between labhud and a service could
# collect its key. Pin each one: `python3 init.py fingerprint https://host:port` prints the line.
#LABHUD_PINS=192.0.2.10:8006=<sha256>,192.0.2.20:8007=<sha256>
# Or check them the normal way, against the system CAs plus your own (an internal CA):
#LABHUD_VERIFY=on
#LABHUD_CA=/run/secrets/my-ca.pem
# HTTPS on labhud's own port, with your certificate (PEM). Agents pushing to it pin it with
# LABHUD_AGENT_PUSH_PIN. Without these, plain HTTP.
#LABHUD_TLS_CERT=/run/secrets/labhud-cert.pem
#LABHUD_TLS_KEY=/run/secrets/labhud-key.pem
# Any variable here can come from a file instead: LABHUD_PBS_TOKEN_SECRET_FILE=/run/secrets/pbs
# (Docker secrets, systemd LoadCredential). The file's content is the value.

# --- notifications (optional) ---------------------------------------------------------------
# Bad news from the history (a host down, a source that stopped answering, a new alert) is
# POSTed here. Formats: ntfy, gotify (put ?token=<app token> in the URL), discord, json.
#LABHUD_NOTIFY_URL=https://ntfy.example.com/labhud
#LABHUD_NOTIFY_FORMAT=ntfy
# Sent as the Authorization header, e.g. "Bearer tk_..." for a protected ntfy topic.
#LABHUD_NOTIFY_AUTH=
# A host down is sent only if still down this many seconds later (a reboot says nothing).
#LABHUD_NOTIFY_DELAY=120
# 1: also the good news (back up, answering again, labhud started).
#LABHUD_NOTIFY_ALL=0

# --- Proxmox VE (one block per node; standalone nodes and clusters both work) ---------------
# Put the node that is always on first: it carries the combined storage list.
#LABHUD_PROXMOX_NODES=pve,node2
#LABHUD_PROXMOX_PVE_URL=https://192.0.2.11:8006
#LABHUD_PROXMOX_PVE_TOKEN_ID=labhud@pve!labhud
#LABHUD_PROXMOX_PVE_TOKEN_SECRET=

# --- Proxmox Backup Server -----------------------------------------------------------------
#LABHUD_PBS_URL=https://192.0.2.12:8007
#LABHUD_PBS_TOKEN_ID=labhud@pbs!labhud
#LABHUD_PBS_TOKEN_SECRET=

